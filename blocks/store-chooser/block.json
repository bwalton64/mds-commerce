{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mds-commerce/store-chooser",
	"version": "3.0.0",
	"title": "Store Chooser",
	"category": "mds-release-manager",
	"icon": "cart",
	"description": "Displays available storefront and on-demand physical media options for a Release, grouped by format with coupon and special-offer prioritization.",
	"textdomain": "mds-commerce",
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"attributes": {
		"releaseId": {
			"type": "number",
			"default": 0
		},
		"groupBy": {
			"type": "string",
			"default": "format"
		},
		"layout": {
			"type": "string",
			"default": "cards"
		},
		"prioritizePromos": {
			"type": "boolean",
			"default": true
		},
		"heading": {
			"type": "string",
			"default": ""
		}
	},
	"editorScript": "file:../../build/index.js",
	"viewScript": "file:../../build/view.js",
	"style": "file:../../build/style.css"
}
